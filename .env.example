# ==================== DATABASE CONFIGURATION ====================
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mapleads
DB_USER=postgres
DB_PASSWORD=your_password_here

# ==================== SCRAPER CONFIGURATION ====================
MAX_RESULTS_PER_SEARCH=100
DELAY_BETWEEN_REQUESTS_MIN=3
DELAY_BETWEEN_REQUESTS_MAX=8
HEADLESS_MODE=True
BROWSER_TIMEOUT=60000

# ==================== RATE LIMITING ====================
MAX_REQUESTS_PER_HOUR=100
COOLDOWN_AFTER_DETECTION=1800

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# ==================== CAPTCHA SOLVING (2Captcha) ====================
CAPTCHA_ENABLED=False
CAPTCHA_API_KEY=your_2captcha_api_key_here

# ==================== GOOGLE SHEETS INTEGRATION ====================
GOOGLE_SHEETS_ENABLED=False
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json

# ==================== WEBHOOK NOTIFICATIONS ====================
# Slack
SLACK_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=C0123456789

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ==================== EMAIL NOTIFICATIONS ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient1@email.com,recipient2@email.com

# ==================== CRM INTEGRATIONS ====================
# HubSpot
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Salesforce
SALESFORCE_USERNAME=your_salesforce_email
SALESFORCE_PASSWORD=your_salesforce_password
SALESFORCE_SECURITY_TOKEN=your_security_token
SALESFORCE_DOMAIN=login

# ==================== AIRTABLE INTEGRATION ====================
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ==================== NOTION INTEGRATION ====================
NOTION_API_KEY=secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==================== AI FEATURES ====================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_LEAD_SCORING_ENABLED=False

# ==================== EMAIL VERIFICATION ====================
EMAIL_VERIFICATION_API_KEY=your_verification_api_key
EMAIL_VERIFICATION_PROVIDER=abstract

# ==================== SCHEDULING ====================
SCHEDULER_ENABLED=False
SCHEDULER_TIMEZONE=UTC

# ==================== AUTHENTICATION ====================
AUTH_ENABLED=False
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
